# Used only by `vercel dev` when testing api/generate.js locally — never
# read by the Vite frontend itself (that's the whole point: this key is
# server-side only). Copy to api/.env, fill in a real key, and it'll be
# picked up automatically by `vercel dev`.
#
# For an actual deployment, set this in the Vercel dashboard instead:
# Project Settings -> Environment Variables -> GROQ_API_KEY (no VITE_
# prefix). Get a key at https://console.groq.com/keys.
GROQ_API_KEY=gsk_your_key_here
