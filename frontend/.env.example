# Which PipelineDataSource implementation the app uses.
# "mock" (default) — fully interactive, zero backend required, runs entirely
#   against the bundled sample documents. Good for frontend-only work.
# "http" — talks to the real backend in ../backend over HTTP. Run
#   `uvicorn api:app --port 8000` there first — see the root README's Quick
#   Start. The endpoint contract is documented in
#   src/services/httpPipelineDataSource.ts.
VITE_PIPELINE_DATA_SOURCE=mock

# Base URL for the "http" data source. Ignored in "mock" mode.
# Matches backend/api.py's default local port (uvicorn api:app --port 8000).
VITE_API_BASE_URL=http://localhost:8000/api

# NOTE: for a deployed/hosted default key, see api/.env.example instead —
# never put that here (see the warning on VITE_GROQ_API_KEY below).

# Local development convenience ONLY. If set, and only while this app is
# genuinely running on localhost (checked at runtime — see
# src/utils/environment.ts), this key is used directly instead of needing
# `vercel dev` or the LLM settings UI, so plain `npm run dev` can still get
# real generated answers without extra steps.
#
# DO NOT set this in any environment that will ever produce a build meant
# for deployment. Vite inlines every VITE_*-prefixed variable directly into
# the built JS bundle — the localhost runtime check only gates whether the
# already-bundled value gets USED, not whether it's PRESENT in the bundle's
# source, which anyone can read via devtools regardless of that check. If
# you build this app for deployment (`npm run build`) with this variable
# set in your environment, the key ships in the public bundle. Double-check
# it's unset before any production build — or better, just don't set it at
# all here and rely on api/.env.example (server-side only) plus the LLM
# settings UI (BYOK, sessionStorage only) instead, which have no such risk.
# VITE_GROQ_API_KEY=gsk_your_own_key_for_local_dev_only
